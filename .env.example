# Create the Telegram token with @BotFather.
TELEGRAM_BOT_TOKEN=
# Railway supplies DATABASE_URL when PostgreSQL is attached.
DATABASE_URL=
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Public HTTPS address opened by Telegram. Railway's public domain is used automatically when available.
# MINI_APP_URL=https://your-domain.up.railway.app/app
# Optional owner Telegram ID for future admin commands.
ADMIN_TELEGRAM_ID=

# Keep live customer keys blocked until sandbox onboarding is proven.
ALLOW_LIVE_TRADING=false

# Risk presets used by the one-tap ticket.
DEFAULT_RISK_USD=75
MAX_RISK_USD=100
DEFAULT_STOP_PERCENT=0.5
DEFAULT_REWARD_RISK=1.8
DEFAULT_LEVERAGE=2
MAX_LOSS_ROOM_USAGE_PERCENT=20
CONFIRMATION_TTL_SECONDS=45
GUARDIAN_MONITOR_SECONDS=90

# Global kill switch: reads and full ticket validation still work, orders do not submit.
DRY_RUN=true

# Railway supplies PORT automatically. Local default is 3000.
PORT=3000
