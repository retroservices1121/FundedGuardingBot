# Create the Telegram token with @BotFather.
TELEGRAM_BOT_TOKEN=
# Railway supplies DATABASE_URL when PostgreSQL is attached.
DATABASE_URL=
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Public HTTPS address opened by Telegram. Railway's public domain is used automatically when available.
# MINI_APP_URL=https://your-domain.up.railway.app/app
# Optional owner Telegram ID for future admin commands.
ADMIN_TELEGRAM_ID=

# Keep live customer keys blocked until sandbox onboarding is proven.
ALLOW_LIVE_TRADING=false

# Risk presets used by the one-tap ticket.
DEFAULT_RISK_USD=75
MAX_RISK_USD=100
DEFAULT_STOP_PERCENT=0.5
DEFAULT_REWARD_RISK=1.8
DEFAULT_LEVERAGE=2
MAX_LOSS_ROOM_USAGE_PERCENT=20
CONFIRMATION_TTL_SECONDS=45
GUARDIAN_MONITOR_SECONDS=90

# Global kill switch: reads and full ticket validation still work, orders do not submit.
DRY_RUN=true

# Railway supplies PORT automatically. Local default is 3000.
PORT=3000

# Optional public Telegram channel feed. Leave PULSE_CHANNEL_ID blank to disable it.
# Add the bot as a channel admin with permission to post, then use @channelusername
# or the numeric -100... channel ID here.
PULSE_CHANNEL_ID=
PULSE_PROVIDER=binance
PULSE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
PULSE_MOVE_PERCENT=1
PULSE_MOVE_WINDOW_MINUTES=15
PULSE_VOLUME_MULTIPLIER=3
PULSE_SPREAD_BPS=10
PULSE_ALERT_COOLDOWN_MINUTES=60
PULSE_BRIEF_HOUR_ET=8

# Optional CryptoPanic news-catalyst layer. Get a free token at:
# https://cryptopanic.com/developers/api/keys
CRYPTOPANIC_TOKEN=
CRYPTOPANIC_API_URL=https://cryptopanic.com/api/free/v2/posts/
PULSE_NEWS_POLL_MINUTES=5
PULSE_NEWS_MAX_AGE_MINUTES=45
PULSE_NEWS_MOVE_PERCENT=0.5
# Only headlines from these source domains are eligible for channel posts.
PULSE_NEWS_SOURCES=reuters.com,apnews.com,bloomberg.com,coindesk.com,theblock.co,cointelegraph.com,decrypt.co,sec.gov,federalreserve.gov
